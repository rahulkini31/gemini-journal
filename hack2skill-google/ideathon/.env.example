# GEMINI_API_KEY is injected server-side from Google Cloud Secret Manager.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL is the Cloud Run service URL after deployment.
APP_URL="MY_APP_URL"

# VITE_ADK_AGENT_URL points the browser at the separate, experimental ADK
# agent prototype (adk-agent/, branch prototype/adk-python-agent) for the
# graph visualization feature only (src/lib/graphApi.ts) — this app's own
# backend (server.ts) is unaffected and unaware of it. Not a secret; it's
# baked into the client bundle like any other VITE_* var. Run the Python
# service on a different port than this app's own server (which also
# defaults to 8080) — e.g. `PORT=8090 python -m app.main` from adk-agent/.
VITE_ADK_AGENT_URL="http://localhost:8090"
